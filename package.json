{
  "name": "cks-studio",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check --write src/",
    "ci": "biome ci src/ && tsc --noEmit && vitest run",
    "mcp": "bash start-mcp.sh",
    "mcp:create-demo": "bash scripts/create-demo-session.sh",
    "mcp:import-ecosystem": "python3 scripts/import-ecosystem-graph.py"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.11.2",
    "3d-force-graph": "^1.79.0",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "description": "> Interactive visual workspace for the Canonical Knowledge Structure ecosystem.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deus-corp/cks-studio.git"
  },
