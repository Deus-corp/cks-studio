{
  "name": "cks-studio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check --write src/",
    "ci": "biome ci src/ && tsc --noEmit && vitest run",
    "mcp": "bash start-mcp.sh",
    "mcp:create-demo": "bash scripts/create-demo-session.sh",
    "mcp:import-ecosystem": "python3 scripts/import-ecosystem-graph.py"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.0.0",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "description": "> Interactive visual workspace for the Canonical Knowledge Structure ecosystem.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deus-corp/cks-studio.git"
  },
  "keywords": [],
